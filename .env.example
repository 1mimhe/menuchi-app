# Copy to .env and fill real values. Never commit .env.
PORT=8000
MENUCHI_FRONT_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/menuchi
REDIS_URL=redis://default@localhost:6379/0
TRANSFORMERS_REDIS_URL=redis://default@localhost:6379/1
OTP_REDIS_URL=redis://default@localhost:6379/2
TRANSFORMERS_STREAM=images
OTP_STREAM=otps
INTERNAL_OTP_URL=http://localhost:9000
INTERNAL_OTP_ENDPOINT=/api/v1/get-otp
S3_BUCKETNAME=your-bucket
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESSKEYID=your-access-key
S3_SECRETACCESSKEY=your-secret-key
S3_DEFAULT_KEY=your-bucket/default.jpg
SESSION_SECRET=generate-32plus-random-bytes-here
COOKIE_PRIVATE_KEY=generate-16plus-random-here
JWT_PRIVATE_KEY=generate-16plus-random-here
